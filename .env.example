# Managed Postgres (Neon / Supabase / Railway): paste the provider URI.
# Local Docker: docker compose up -d  (see docker-compose.yml)
DATABASE_URL=postgresql://lunora:lunora@127.0.0.1:5433/lunora

# Single admin password for /admin (v1 — no multi-admin roles yet)
ADMIN_PASSWORD=changeme

# Public site URL used for Safepay redirect/cancel links
APP_URL=http://localhost:3000

# Unpaid online orders hold stock this long, then inventory is released
ONLINE_PAYMENT_HOLD_MINUTES=25

# Leopards staging (dummy keys enable the local booking simulator)
LEOPARDS_SIMULATE=true
LEOPARDS_ENV=staging
LEOPARDS_API_KEY=sandbox_dummy_leopards
LEOPARDS_API_PASSWORD=sandbox_dummy_password
LEOPARDS_WEBHOOK_SECRET=lunora-leopards-webhook
LEOPARDS_ORIGIN_CITY_ID=1
LEOPARDS_PICKUP_NAME=Lunora Living
LEOPARDS_PICKUP_PHONE=03000000000
LEOPARDS_PICKUP_ADDRESS=Lunora warehouse, Lahore

# Safepay sandbox (never commit live keys). Dummy values enable the local
# hosted-checkout simulator. Replace with dashboard keys and set
# SAFEPAY_SIMULATE=false to hit sandbox.api.getsafepay.com.
SAFEPAY_SIMULATE=true
SAFEPAY_ENV=sandbox
SAFEPAY_API_KEY=sec_sandbox_dummy_lunora
SAFEPAY_SECRET_KEY=sandbox_dummy_secret
# Base64 webhook signing secret (HMAC-SHA256 per Safepay docs)
SAFEPAY_WEBHOOK_SECRET=bHVub3JhLXdlYmhvb2stc2FuZGJveC1zZWNyZXQ=

# Pexels (lifestyle/mood photos only). Instant key from https://www.pexels.com/api/
# Without a key, curated Pexels CDN photos + attribution still render.
PEXELS_API_KEY=
